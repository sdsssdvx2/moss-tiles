{
  // family-invest-paper-v2: PAPER TRADING ONLY. New worker; the old
  // family-invest-krx-paper-256fe555dc worker/D1 stay untouched as fallback.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-invest-paper-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-invest-paper-v2-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI (free 10k neurons/day, no key). AI 판단 job: 4 runs/day × (2 same-prompt samples + 1 cross-model sample).
  // + 읽기 전용 Q&A 하루 최대 30회(≈100~160 neurons/회, 추정). 합계 추정 ≈ 2k + 최대 4.8k < 10k.
  // gpt-oss-120b = 31,818 neurons/M input + 68,182/M output → ≈120-150 neurons/call → ≈1.0-1.3k neurons/day.
  "ai": { "binding": "AI" },
  "triggers": {
    // Free plan: max 5 cron triggers per account. We use 1: every 10 minutes a small unit of work
    // (collect / paper step / evaluation) + Telegram summary/alerts on the owner-editable schedule
    // (dashboard 데이터·비용 → 알림 설정; default 08:40 KST daily).
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "COLLECT_ENABLED": "true",
    "ALLOW_UNOFFICIAL_NAVER": "true",
    "DATA_TASKS_PER_TICK": "2",
    "KRX_BACKFILL_YEARS": "5",
    "CRYPTO_BACKFILL_DAYS": "1100",
    "NEWS_VETO_PROVIDER": "ai",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/openai/gpt-oss-120b",
    "AI_FALLBACK_MODELS": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/zai-org/glm-4.7-flash",
    "AI_SAMPLES": "2",
    // 다른 무료 모델 교차 판단: auto = 목록의 다음 모델 1회(엇갈린 종목은 점수 절반), off = 끔
    "AI_CROSS_MODEL": "auto",
    // 연구실에게 물어보기(읽기 전용 Q&A): 하루에 AI로 답하는 횟수 상한. 넘으면 AI 없이 저장된 기록으로 답함
    "ASK_DAILY_MAX": "30",
    "LOG_TICKS": "false",
    // 코인 시장 신호 (위험 신호 전용). 기준값 바꾸기: MARKET_SIGNALS_JSON 예) {"premHold":0.06,"derivRules":false}
    "MARKET_SIGNALS_ENABLED": "true",
    // 주간 자동 연구 결과(공개 저장소, 토큰 불필요). 6시간마다 확인, 새 결과만 반영.
    "RESEARCH_URL": "https://raw.githubusercontent.com/sdsssdvx2/moss-tiles/main/backtest/results/import.json"
  },
  // Secrets (set with `wrangler secret put`, never in this file):
  //   OWNER_PASSWORD (required), KRX_AUTH_KEY, DATA_GO_KR_KEY (optional data),
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (optional), EXPORT_TOKEN, INGEST_TOKEN (optional machine APIs).
  //   There are NO broker/exchange order keys in this project.
  "observability": { "enabled": true, "head_sampling_rate": 1.0 }
}
